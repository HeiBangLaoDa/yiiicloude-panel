# Payload 数据库 — 复用 control-plane Postgres 实例（端口 54324），新建 db `yiiicloude_panel`
DATABASE_URI=postgres://yiiicloude:yiiicloude@127.0.0.1:54324/yiiicloude_panel

# Payload encryption secret — 用于 cookie / JWT / API key 签名。生产前必须改成随机长串
PAYLOAD_SECRET=dev-secret-change-me-in-prod

# control-plane 当前还在跑（Phase D cutover 前 panel 不直接读它，但 Fernet 加密策略迁移期会用到）
CONTROL_PLANE_URL=http://127.0.0.1:8070
ADMIN_SECRET=dev
