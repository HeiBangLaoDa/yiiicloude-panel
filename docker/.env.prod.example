# yiiicloude-panel prod env example
# 实际 .env 写到 /etc/yiiicloude-panel/.env（mode 600，不入 git）
#
# ── Postgres ──
POSTGRES_USER=yiiicloude_panel
POSTGRES_PASSWORD=<RANDOM_24_HEX>
POSTGRES_DB=yiiicloude_panel

# ── Payload ──
# 32 字节 hex（生成: openssl rand -hex 32）
PAYLOAD_SECRET=<RANDOM_HEX_32>

# Fernet 加密 key（与 control-plane 同 key 才能互相解密 ImBindings）
# 生成: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_FERNET_KEY=<FERNET_KEY>

# ── 集成 ──
# control-plane 在同 host docker，走 yiiicloude-public 内网 service name
CONTROL_PLANE_URL=http://yiiicloude-control-plane-app:8070

# 写 API 鉴权（与 control-plane ADMIN_SECRET 同值）
ADMIN_SECRET=<SHARED_WITH_CONTROL_PLANE>
